{
  "manifest_version": 3,
  "name": "Link Opportunities",
  "version": "4.6.0",
  "description": "Semantic internal link suggestions for SEO. Import a pages CSV, add an OpenAI key, and get real-time suggestions in any CMS, Google Docs, or on live pages.",

  "permissions": [
    "storage",
    "unlimitedStorage",
    "activeTab",
    "scripting",
    "clipboardWrite",
    "contextMenus",
    "alarms"
  ],

  "host_permissions": [
    "<all_urls>",
    "https://api.openai.com/*"
  ],

  "background": {
    "service_worker": "background.js"
  },

  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "css": ["styles.css"],
      "run_at": "document_idle"
    }
  ],

  "icons": {
    "16":  "icon16.png",
    "32":  "icon32.png",
    "48":  "icon48.png",
    "128": "icon128.png"
  },

  "action": {
    "default_popup": "popup.html",
    "default_title": "Link Opportunities",
    "default_icon": {
      "16":  "icon16.png",
      "32":  "icon32.png",
      "48":  "icon48.png",
      "128": "icon128.png"
    }
  },

  "web_accessible_resources": [
    {
      "resources": ["visualize.html"],
      "matches": ["<all_urls>"]
    }
  ]
}
